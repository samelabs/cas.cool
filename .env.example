# ── Core ──
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:***@localhost:5432/cascool?schema=public"

# JWT session secret (use a strong random string, e.g. `openssl rand -base64 32`)
JWT_SECRET=""

# ── Optional ──
# Max connections in the Prisma pg pool (default 10)
# DB_POOL_MAX=10
