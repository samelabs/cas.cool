# ── Core ──
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:***@localhost:5432/cascool?schema=public"

# JWT session secret (use a strong random string, e.g. `openssl rand -base64 32`)
JWT_SECRET=""

# ── Media storage (server runtime; required for media operations) ──
# Physical root for PUBLIC post media, served at /uploads/. Absolute path.
# For local dev you can keep these inside the checkout, e.g.
#   UPLOAD_DIR="/absolute/path/to/cascool/public/uploads"
#   PRIVATE_UPLOAD_DIR="/absolute/path/to/cascool/private-uploads"
# In production both may live on shared storage outside the app directory
# (the in-repo paths can be symlinks to it). The reverse proxy's /uploads/
# alias MUST point at the SAME physical storage as UPLOAD_DIR, and the two
# roots must be disjoint directory trees. No defaults: a missing/relative/
# overlapping pair fails loudly at the first media operation
# (src/lib/media-storage.ts).
UPLOAD_DIR=""
PRIVATE_UPLOAD_DIR=""

# ── Optional ──
# Max connections in the Prisma pg pool (default 10)
# DB_POOL_MAX=10
