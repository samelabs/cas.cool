# ── Core ──
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cascool?schema=public"

# JWT session secret (use a strong random string, e.g. `openssl rand -base64 32`)
JWT_SECRET=""

# ── Next.js ──
# No additional env required — DATABASE_URL and JWT_SECRET cover the web process.

# ── Public API (services/public-api) ──
PUBLIC_API_HOST="127.0.0.1"
PUBLIC_API_PORT="8001"
PUBLIC_API_DB_POOL_SIZE="5"
PUBLIC_API_BODY_LIMIT_BYTES="65536"
PUBLIC_API_REQUEST_TIMEOUT_MS="15000"
